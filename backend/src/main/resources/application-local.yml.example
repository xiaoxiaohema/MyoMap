# ===== 本地开发配置模板 =====
# 使用方法：复制本文件为 application-local.yml，再填入本机真实口令。
#   cp application-local.yml.example application-local.yml
# application-local.yml 已被 .gitignore 排除，不会被提交。
#
# 也可以完全不使用本文件，改为设置环境变量（优先级更高）：
#   export MYOMAP_DB_USERNAME=root
#   export MYOMAP_DB_PASSWORD=你的数据库口令
#   export MYOMAP_JWT_SECRET=至少32字节的随机字符串

spring:
  datasource:
    username: root
    password: your-mysql-password

myomap:
  jwt:
    secret: change-me-to-a-random-string-at-least-32-bytes
