# ============================================================
#  MyoMap · 前端镜像（全栈部署，含 /api 反向代理）
#  构建： bash deploy/build.sh
#         docker build -f deploy/Dockerfile.full -t myomap-web .
# ============================================================

FROM nginx:alpine

COPY dist/ /usr/share/nginx/html/
COPY deploy/nginx.full.conf /etc/nginx/conf.d/default.conf

EXPOSE 80
CMD ["nginx", "-g", "daemon off;"]
