<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.myomap.backend</string>

    <key>ProgramArguments</key>
    <array>
        <string>/path/to/jdk17/bin/java</string>
        <string>-Xms128m</string>
        <string>-Xmx512m</string>
        <string>-jar</string>
        <string>/path/to/MyoMap/backend/target/myomap-backend-1.0.0.jar</string>
    </array>

    <key>WorkingDirectory</key>
    <string>/path/to/MyoMap/backend</string>

    <key>RunAtLoad</key>
    <true/>

    <key>KeepAlive</key>
    <true/>

    <key>StandardOutPath</key>
    <string>/tmp/myomap-backend.log</string>

    <key>StandardErrorPath</key>
    <string>/tmp/myomap-backend.err.log</string>

    <key>EnvironmentVariables</key>
    <dict>
        <!-- 智谱 GLM API Key：服务端持有，所有电脑登录后无需再配置 -->
        <key>MYOMAP_AI_KEY</key>
